[package]
name = "{{name}}"
version = "0.1.0"
edition = "2021"
rust-version = "1.80"
license = "MIT"
description = "{{Name}}: count things from the keyboard"
publish = false

[lib]
name = "{{crate}}"
path = "src/lib.rs"

[[bin]]
name = "{{name}}"
path = "src/main.rs"

# Runs on the main thread (FLTK wants its UI there), so no libtest harness.
[[test]]
name = "ui"
harness = false

[dependencies]
# Imported as `fltk_omarchy`.
lib-fltk-omarchy = { {{toolkit}} }
# The toolkit pins FLTK; repeat the pin so both crates share one build.
fltk = { version = "=1.5.23", features = ["no-images"] }
serde_json = "1"

[target.'cfg(target_os = "linux")'.dependencies]
fltk = { version = "=1.5.23", features = ["use-wayland", "no-images"] }

[profile.release]
opt-level = "s"
lto = "thin"
codegen-units = 1
panic = "abort"
strip = true

[profile.dev]
incremental = false
debug = "line-tables-only"

[profile.dev.package."*"]
opt-level = 1
