#!/usr/bin/env bash
# Real AT-SPI check of the `a11y` feature: runs examples/a11y_check as a real
# Wayland client on the hidden Hyprland workspace special:omarchy-fltk-test
# (silent: the user's focus is untouched) inside a private D-Bus session with
# its own AT-SPI bus, so turning AT-SPI on (IsEnabled) does not affect the
# user's session and no screen reader runs. script/a11y_atspi.py reads the
# tree and drives the app with AT-SPI actions only.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
OUT="$ROOT/build/a11y-check"
BIN="$ROOT/target/release/examples/a11y_check"
if [[ -z "${A11Y_CHECK_INNER:-}" ]]; then
  [[ -x "$BIN" ]] || cargo build --release --features a11y --example a11y_check
  mkdir -p "$OUT"; rm -f "$OUT"/report.txt "$OUT"/app.log "$OUT"/done
  hyprctl dispatch "hl.dsp.exec_cmd(\"env A11Y_CHECK_INNER=1 dbus-run-session -- $ROOT/script/a11y-check\", { workspace = \"special:omarchy-fltk-test silent\" })" >/dev/null
  for _ in $(seq 1 600); do [[ -e "$OUT/done" ]] && { cat "$OUT/report.txt"; grep -q "^RESULT PASS" "$OUT/report.txt"; exit; }; sleep 0.1; done
  echo "timeout" >&2; exit 1
fi
exec >"$OUT/report.txt" 2>&1
trap 'touch "$OUT/done"' EXIT
echo "private session bus: $DBUS_SESSION_BUS_ADDRESS"
gdbus call --session --dest org.a11y.Bus --object-path /org/a11y/bus \
  --method org.freedesktop.DBus.Properties.Set org.a11y.Status IsEnabled "<true>" >/dev/null
# The a11y bus would ask systemd for the registry (the user's real session):
# run it here instead, on this private bus.
/usr/lib/at-spi2-registryd >/dev/null 2>&1 &
REG=$!
sleep 0.5
OMARCHY_FLTK_A11Y_DEBUG=1 "$BIN" 40 >"$OUT/app.log" 2>&1 &
APP=$!
python3 -I "$ROOT/script/a11y_atspi.py" "$OUT/app.log" || true
kill "$APP" "$REG" 2>/dev/null || true
wait "$APP" 2>/dev/null || true
echo "--- app log"; cat "$OUT/app.log"
