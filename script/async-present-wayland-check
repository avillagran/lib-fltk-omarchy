#!/usr/bin/env python3
"""Exercise xdg-activation in an isolated rootless headless Sway container.

Requires the local o3-qml-wayland-tests image and host wtype. Mounts only
this probe, three X11 client libraries, and a new private fixture directory.
No host display/runtime/input socket is exposed; no image is published.
"""
import json
import os
from pathlib import Path
import subprocess
import time
import uuid

ROOT = Path(__file__).resolve().parent.parent
PROBE = Path(os.environ.get('PRESENT_ASYNC_BIN', str(ROOT/'target/debug/examples/async_present_check'))).resolve()
IMAGE = os.environ.get('PRESENT_WAYLAND_IMAGE', 'localhost/o3-qml-wayland-tests:local')

def main():
    if not (PROBE.is_file() and os.access(PROBE, os.X_OK)):
        raise SystemExit("Build first: cargo build --offline --example async_present_check; override with PRESENT_ASYNC_BIN if needed")
    suffix = uuid.uuid4().hex
    output = ROOT/'build'/('present-wayland-'+suffix)
    output.mkdir(parents=True, mode=0o700)
    (output/'sway.conf').write_text('output * resolution 1280x800\nfocus_follows_mouse no\nfocus_on_window_activation urgent\nseat seat0 fallback true\nxwayland disable\n')
    name = 'fltk-present-'+suffix
    args = ['podman','run','--pull=never','--rm','-d','--name',name,'--network=none','--userns=keep-id','--user',f'{os.getuid()}:{os.getgid()}','--entrypoint','/bin/sh',
            '-v',f'{output}:/fixture:rw','-v',f'{PROBE}:/probe:ro','-v','/usr/bin/wtype:/wtype:ro']
    for lib in ('libXinerama.so.1','libXcursor.so.1','libXfixes.so.3'):
        args += ['-v',f'/usr/lib/{lib}:/usr/lib/{lib}:ro']
    args += ['-e','XDG_RUNTIME_DIR=/fixture','-e','WLR_BACKENDS=headless','-e','WLR_RENDERER=pixman','-e','WLR_LIBINPUT_NO_DEVICES=1',IMAGE,'-c',
             'cp /usr/sbin/sway /fixture/sway && exec /fixture/sway -c /fixture/sway.conf > /fixture/sway.log 2>&1']
    subprocess.run(args,check=True,stdout=subprocess.DEVNULL)
    keyboard = None
    try:
        end = time.monotonic()+10
        while not list(output.glob('wayland-*.lock')) or not list(output.glob('sway-ipc.*.sock')):
            if time.monotonic()>end: raise RuntimeError('compositor startup timeout; inspect sway.log')
            time.sleep(.05)
        display = next(output.glob('wayland-*.lock')).name.removesuffix('.lock')
        sock = '/fixture/'+next(output.glob('sway-ipc.*.sock')).name
        def execute(*command):
            return subprocess.check_output(['podman','exec','-e',f'SWAYSOCK={sock}','-e',f'WAYLAND_DISPLAY={display}',name,*command],text=True,timeout=8)
        subprocess.run(['podman','exec','-d','-e',f'WAYLAND_DISPLAY={display}','-e','FLTK_BACKEND=wayland','-e','OMARCHY_FLTK_A11Y=off','-e','XDG_CONFIG_HOME=/fixture/config','-e','OMARCHY_FLTK_STATE_DIR=/fixture/state','-e','DESKTOP_STARTUP_ID=unchanged','-e','XDG_ACTIVATION_TOKEN=unchanged',name,'/bin/sh','-c','/probe /fixture > /fixture/application.log 2>&1'],check=True)
        def read(filename):
            end=time.monotonic()+8
            while time.monotonic()<end:
                try: return json.loads((output/filename).read_text())
                except (FileNotFoundError,json.JSONDecodeError): time.sleep(.03)
            raise RuntimeError(f'timeout {filename}; inspect application.log')
        end=time.monotonic()+8
        while not (output/'ready').exists():
            if time.monotonic()>end: raise RuntimeError('probe startup timeout; inspect application.log')
            time.sleep(.05)
        def nodes(node):
            yield node
            for key in ('nodes','floating_nodes'):
                for child in node.get(key,[]): yield from nodes(child)
        def focused():
            return next((n.get('name') for n in nodes(json.loads(execute('swaymsg','-t','get_tree'))) if n.get('focused')),None)
        execute('swaymsg','focus_on_window_activation smart')
        execute('swaymsg','[title="^async-probe-a$"] focus')
        keyboard=subprocess.Popen(['podman','exec','-e',f'WAYLAND_DISPLAY={display}',name,'/wtype','-s','300','1','-s','15000'])
        end=time.monotonic()+8
        while time.monotonic()<end and not (output/'result-1').exists(): time.sleep(.05)
        assert 'Requested' in (output/'result-1').read_text(), 'async request did not complete'
        end=time.monotonic()+3
        while time.monotonic()<end and focused()!='async-probe-b': time.sleep(.05)
        assert focused()=='async-probe-b', 'captured gesture did not activate after callback'
        execute('swaymsg','[title="^async-probe-a$"] focus')
        (output/'synthetic').write_text('1')
        end=time.monotonic()+8
        while time.monotonic()<end and not (output/'result-2').exists(): time.sleep(.05)
        assert (output/'synthetic-reply').read_text()=='true', 'synthetic event not delivered'
        assert 'Requested' in (output/'result-2').read_text(), 'synthetic request did not complete'
        time.sleep(.2)
        assert focused()=='async-probe-a', 'synthetic event borrowed prior serial'
        (output/'done').write_text('done\n')
        print('PASS async Wayland: native gesture captured before poll; synthetic input cannot borrow prior serial')
        print(output)
    finally:
        subprocess.run(['podman','stop','--time','3',name],stdout=subprocess.DEVNULL,check=False,timeout=8)
        if keyboard is not None:
            keyboard.wait(timeout=5)

if __name__=='__main__': main()
